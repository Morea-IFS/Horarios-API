# Copie para .env (cp .env.example .env). NUNCA envie o .env para o GitHub.

# Banco local (docker compose up -d db). Em produção/Supabase, use a string de conexão do provedor.
DATABASE_URL="postgresql://mero:mero_local_dev@localhost:5433/mero_horarios?schema=public"

# Porta da API
PORT=3000

# Limite de requisições por minuto, por IP
# Por IP. Na rede do campus muita gente sai pelo mesmo IP, então o valor não deve ser baixo.
RATE_LIMIT_PER_MINUTE=300

# Origens permitidas no navegador (CORS), separadas por vírgula. "*" libera qualquer origem (a API é só leitura).
CORS_ORIGINS=*
